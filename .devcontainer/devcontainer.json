{
  "name": "Bridge Builder workshop",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "vscode",
      "webPort": "6080",
      "vncPort": "5901"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },


  "updateContentCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && npm install -g @anthropic-ai/claude-code @modelcontextprotocol/inspector",

  "postCreateCommand": "$HOME/.local/bin/uv sync --extra dev",

  "secrets": {
    "ANTHROPIC_API_KEY": {
      "description": "Anthropic API key for Claude Code (sk-ant-...). Stored as your own Codespaces secret, never in this repository.",
      "documentationUrl": "https://docs.anthropic.com/en/docs/claude-code/settings#environment-variables"
    }
  },

  "remoteEnv": {
    "DISPLAY": ":1",
    "PATH": "${containerEnv:HOME}/.local/bin:${containerEnv:PATH}"
  },

  "forwardPorts": [6080, 8765, 8888, 6274, 6277],

  "portsAttributes": {
    "6080": {
      "label": "Game desktop (noVNC, password: vscode)",
      "onAutoForward": "notify"
    },
    "8765": {
      "label": "MCP server (bridge-engineer)",
      "onAutoForward": "silent"
    },
    "8888": {
      "label": "Jupyter notebook",
      "onAutoForward": "notify"
    },
    "6274": {
      "label": "MCP Inspector (UI)",
      "onAutoForward": "silent"
    },
    "6277": {
      "label": "MCP Inspector (proxy)",
      "onAutoForward": "silent"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-renderers",
        "charliermarsh.ruff",
        "anthropic.claude-code",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvInCurrentTerminal": true,
        "terminal.integrated.defaultProfile.linux": "bash",
        "jupyter.notebookFileRoot": "${workspaceFolder}"
      }
    }
  },

  "remoteUser": "vscode"
}
